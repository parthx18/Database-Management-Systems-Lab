1. create a table emp2 with fields empno as int ,name as character ,category as int (take only 3 categories ie 1,2 and 3)
2. design a trigger for insertion or updation a new record in capital letters only
hint : name =upper(name);
3. add another filed salary as number to the table.
4. design a trigger for insertion or updation for the following:
if category is 1 then salary should be more than 10000
if category is 2 then salary should be more than 20000
if category is 3 then salary should be more than 30000


CREATE TABLE emp2 (
    empno INT PRIMARY KEY,
    name VARCHAR(100),
    category INT,
    CHECK (category IN (1, 2, 3))
);
CREATE OR REPLACE TRIGGER emp2_biu
BEFORE INSERT OR UPDATE ON emp2
FOR EACH ROW
BEGIN
    :NEW.name := UPPER(:NEW.name);
END; 
/
ALTER TABLE emp2 ADD salary NUMBER;
CREATE OR REPLACE TRIGGER emp2_salary_check
BEFORE INSERT OR UPDATE ON emp2
FOR EACH ROW
BEGIN
    IF :NEW.category = 1 AND :NEW.salary <= 10000 THEN
        RAISE_APPLICATION_ERROR(-20001, 'Salary must be more than 10000');
    ELSIF :NEW.category = 2 AND :NEW.salary <= 20000 THEN
        RAISE_APPLICATION_ERROR(-20002, 'Salary must be more than 20000');
    ELSIF :NEW.category = 3 AND :NEW.salary <= 30000 THEN
        RAISE_APPLICATION_ERROR(-20003, 'Salary must be more than 30000');
    END IF;
END;
/


design a trigger to stop insertion or updation in the table for the days like sat or sun of any date(for practice purpose take the day as 'tue')
create or replace trigger no_ins_upd
(as) declare  
v_day varchar2(10);
begin
v_day := to_char(sysdate,'dy');
if v_day ='tue' then
raise_application_error(-20001,'cant insert or update on the table on '|| v_day);
