create or replace trigger Min_Max_salary
before insert or update on emp2
for each row
DECLARE
  max_sal number(10,2);
  min_sal number(10,2);
begin 
select min(sal) * 10 into max_sal from emp2;
select max(sal) / 10 into min_sal FROM emp2;
if :new.sal  not between min_sal and max_sal then
    raise_application_error(-20021, 'Salary out of allowed range');
  end if;
end;
/
